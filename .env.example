APP_NAME=ORBIT
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# ORBIT targets PostgreSQL (ADR-0002). SQLite is fine for a quick local start;
# the automated tests always use in-memory SQLite (see phpunit.xml).
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=orbit
DB_USERNAME=orbit
DB_PASSWORD=

# --- ORBIT ---------------------------------------------------------------
# Where public contact-form submissions are e-mailed (leave empty to only store them).
ORBIT_CONTACT_RECIPIENT=
# Shown on public pages and in transactional mail.
ORBIT_SUPPORT_EMAIL=support@example.test
# Require the responsible contact to verify their e-mail before the
# organisation becomes active. Keep true outside local development.
ORBIT_REQUIRE_EMAIL_VERIFICATION=true
# Also require a confirmed phone before the workspace opens.
# Until an SMS provider is configured, the one-time code is written to the log.
ORBIT_REQUIRE_PHONE_VERIFICATION=true
# Local demo sign-in password (letters and numbers, at least 10 characters).
# Used only by: php artisan db:seed --class=SystemDemoUserSeeder
# Leave empty in shared and production environments.
ORBIT_DEMO_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="no-reply@example.test"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
